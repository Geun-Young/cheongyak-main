# Supabase 프로젝트 설정 → Project Settings → API 에서 확인
# anon public key만 사용한다. service_role 키는 절대 여기 넣지 않는다(서버 전용, RLS 우회 권한).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. DDL 마이그레이션·시딩·수집 스크립트에서만 쓴다. 절대 NEXT_PUBLIC_ 접두사 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 공공데이터포털(data.go.kr) 일반 인증키(Decoding) — 마이홈포털/청약홈/LH 공지사항 API 공용
DATA_GO_KR_API_KEY=

# Gemini API 키 (aistudio.google.com/app/apikey 에서 발급) — PDF 자격요건 초안 추출용
GEMINI_API_KEY=

# 카카오맵 JS SDK 키 (지도) — 카카오 디벨로퍼스 앱 등록 후 발급
# NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 로그인 버튼 노출 여부.
# Supabase가 카카오에 account_email scope를 강제로 넣는데 그 동의항목은 비즈앱 전환을
# 해야 열린다(개인 개발자 앱에서는 KOE205). 전환이 끝나면 true로 바꾸면 버튼이 나온다.
# NEXT_PUBLIC_ENABLE_KAKAO_LOGIN=true

# 네이버 검색 API (단지 인기도 = 경쟁률 대리지표)
# NAVER API HUB에서 발급한다 — 구 개발자센터(developers.naver.com)는 2026-07-31부로
# 신규 신청이 막혔고 2027-06-30에 종료된다.
# https://www.ncloud.com 콘솔 > NAVER API HUB > 검색 API 신청 > API Key 발급
# NAVER_API_KEY_ID=
# NAVER_API_KEY=

# ── 공고 갱신 자동화(project.md 25·26번) ──
# 관리자 화면 "지금 업데이트" 버튼이 GitHub Actions(daily-update 워크플로)를 실행하게 하려면 넣는다.
# 비워 두면 이 PC에서 `npm run daily:update`를 직접 띄운다(로컬 개발 중에는 이걸로 충분하다).
# 토큰은 fine-grained PAT로, 이 저장소만 · 권한은 Actions: Read and write 하나만 준다.
# GITHUB_ACTIONS_TOKEN=
# GITHUB_REPOSITORY=Geun-Young/cheongyak-main

# 해외(GitHub Actions 등)에서 수집할 때만 supabase로 둔다 — 마이홈포털 요청을 서울 리전
# Edge Function(kr-relay)으로 중계한다. 로컬(한국 IP)에서는 비워 둔다.
# KR_RELAY=supabase
# 중계기 문지기 비밀값. Supabase 함수 비밀값·GitHub 저장소 비밀값에 같은 값으로 들어 있다(로컬에서는 필요 없다).
# KR_RELAY_SECRET=
